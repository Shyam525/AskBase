# ==============================================================================
# AskBase Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets to git.
# ==============================================================================

# Server runtime environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server binding
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Standard format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/askbase
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_ECHO=false

# Authentication & Cryptography
# IN PRODUCTION: JWT_SECRET must be at least 32 characters long and securely generated.
# In development/test, a fallback local secret is used if omitted.
JWT_SECRET=local-development-secret-change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=askbase-api
JWT_AUDIENCE=askbase-clients

# Password Hashing (Argon2id)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Network / HTTP Settings
CORS_ORIGIN=*
LOG_LEVEL=info

# Document Storage & Upload Limits
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_BYTES=20971520

# AI, Retrieval & Grounded Q&A Settings
# Options for EMBEDDING_PROVIDER: 'fake' (deterministic offline) | 'none'
EMBEDDING_PROVIDER=fake
# Options for AI_PROVIDER: 'fake' (deterministic offline extractive synthesizer)
AI_PROVIDER=fake
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEARCH_DEFAULT_LIMIT=10
EVIDENCE_MIN_SIMILARITY=0.15
