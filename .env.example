# ==============================================================================
# AskBase Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets to git.
# ==============================================================================

# Server runtime environment ('development' | 'test' | 'production')
NODE_ENV=development

# Port on which the Express HTTP server listens
PORT=5000

# PostgreSQL connection string
# Matches the local docker-compose PostgreSQL configuration
DATABASE_URL=postgresql://postgres:secret@localhost:5432/askbase

# PostgreSQL connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# JWT Authentication Configuration
# In production, JWT_SECRET must be at least 32 characters long and securely generated.
JWT_SECRET=local-development-secret-change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=askbase-api
JWT_AUDIENCE=askbase-clients

# Password Hashing Configuration (bcrypt salt rounds, 10-12 recommended)
BCRYPT_SALT_ROUNDS=10

# CORS settings (comma-separated origins or '*' for development)
CORS_ORIGIN=*

# Application log level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info
